# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# Never commit your actual .env file.
# ─────────────────────────────────────────────────────────────

# MySQL connection string.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Local dev (with the included docker-compose.yml):
DATABASE_URL="mysql://civicsprep:civicsprep@localhost:3306/civicsprep"
# Hostinger example:
# DATABASE_URL="mysql://u123456789_app:yourpassword@srv1234.hstgr.io:3306/u123456789_passcit"

# Auth.js (NextAuth v5) secret — generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Your app's public base URL (used to build links in emails, etc.)
APP_URL="http://localhost:3000"

# ── Optional: Google sign-in ───────────────────────────────────
# Leave blank to disable Google login (credentials login always works).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Optional: SMTP for password-reset emails ───────────────────
# Leave blank during local dev — reset links will be printed to the
# server console instead of emailed. Hostinger's SMTP works fine here,
# as does any provider (Resend, SendGrid, Gmail app password, etc.).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Passcit <no-reply@yourdomain.com>"

# ── Optional: bootstrap an admin account on first seed ─────────
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── AI-generated study content (Google Gemini) ────────────────────────
# Used for Explanation / Translation / Memory Tip generation on the Learn
# page. Get a key from Google AI Studio: https://aistudio.google.com/apikey
#
# Leaving this blank is supported: the app does not fail or return errors,
# it serves deterministic development placeholders and shows a
# "Development mode" badge, so the study flow stays fully usable locally.
GEMINI_API_KEY=
# Optional, and best left blank. When unset, the app asks the Gemini API
# which models your key can actually use and picks the cheapest suitable
# one. Set a name only to pin a specific model; if that model is retired or
# has no quota on your project, the app falls back automatically.
# The server log lists your usable models on first use.
GEMINI_MODEL=
